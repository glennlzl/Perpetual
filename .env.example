# Optional OpenAI-compatible model for the Browser Agent and discovery; export these in your shell.
PERPETUAL_MODEL_BASE_URL=https://api.openai.com/v1
PERPETUAL_MODEL=
PERPETUAL_MODEL_API_KEY=

# Browser Agent: alternatively set only OPENROUTER_API_KEY; defaults to
# https://openrouter.ai/api/v1 and openai/gpt-6-luna.
# Or set the OpenRouter API Key and model in Settings.
OPENROUTER_API_KEY=

# GitHub: existing `gh auth login` works; GH_TOKEN is also supported.
# These values are never read from the scanned repository's .env files.
GH_TOKEN=
VERCEL_TOKEN=
VERCEL_PROJECT_ID=
VERCEL_TEAM_ID=
RAILWAY_API_TOKEN=
RAILWAY_TOKEN=
RAILWAY_PROJECT_ID=
RAILWAY_ENVIRONMENT_ID=

# Optional direct connectors: Better Auth and SQLite initialize inside Perpetual.
# Register provider OAuth apps once for this installation; see docs/connectors.md.
# The CLI does not auto-load .env. Run from this directory with:
# node --env-file-if-exists=.env src/cli.ts serve --port 4317
# Slack callback: http://localhost:4317/connectors/auth/callback/slack
# Other callbacks: http://127.0.0.1:4317/connectors/auth/callback/{linear,jira}
# Use each provider's actual callback path and the port you serve on.

# Slack: enable public-client PKCE; only CLIENT_ID is used, with user scopes.
PERPETUAL_SLACK_CLIENT_ID=

# Linear: PKCE; CLIENT_SECRET is optional.
PERPETUAL_LINEAR_CLIENT_ID=
PERPETUAL_LINEAR_CLIENT_SECRET=

# Optional localhost broker trial instead of direct Linear OAuth; see bench/connector-broker/README.md.
# Absolute path to a private client pairing file; never put the broker's Composio key here.
PERPETUAL_LINEAR_BROKER_PAIRING=

# Gmail uses the local Composio broker. Same private pairing format as Linear.
# Composio credentials belong on the broker, never in the browser or published code.
PERPETUAL_GMAIL_BROKER_PAIRING=

# Optional Slack and Jira broker trials use the same private pairing format.
PERPETUAL_SLACK_BROKER_PAIRING=
PERPETUAL_JIRA_BROKER_PAIRING=

# Jira: both values are required for the Atlassian 3LO app.
PERPETUAL_JIRA_CLIENT_ID=
PERPETUAL_JIRA_CLIENT_SECRET=
