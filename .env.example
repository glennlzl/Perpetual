# Optional OpenAI-compatible model for the Browser Agent and discovery; export these in your shell.
PERPETUAL_MODEL_BASE_URL=https://api.openai.com/v1
PERPETUAL_MODEL=
PERPETUAL_MODEL_API_KEY=

# Browser Agent: alternatively set only OPENROUTER_API_KEY; defaults to
# https://openrouter.ai/api/v1 and openai/gpt-6-luna.
# Or set the OpenRouter API Key and model in Settings.
OPENROUTER_API_KEY=

# GitHub: existing `gh auth login` works; GH_TOKEN is also supported.
# These values are never read from the scanned repository's .env files.
GH_TOKEN=
VERCEL_TOKEN=
VERCEL_PROJECT_ID=
VERCEL_TEAM_ID=
RAILWAY_API_TOKEN=
RAILWAY_TOKEN=
RAILWAY_PROJECT_ID=
RAILWAY_ENVIRONMENT_ID=
